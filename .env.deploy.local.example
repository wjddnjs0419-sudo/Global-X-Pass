# ───────────────────────────────────────────────────────────────────────────
# .env.deploy.local.example  — prod DB 마이그레이션 배포용 (이관 안내 템플릿)
# ───────────────────────────────────────────────────────────────────────────
# 이 파일은 "형식 안내용"이라 git에 추적된다(비밀 없음, 전부 placeholder).
# 실제 사용 시: 복사 → `.env.deploy.local` 로 만들고 값 채우기.
#   cp .env.deploy.local.example .env.deploy.local
# `.env.deploy.local` 은 git 미추적(.gitignore: .env.* / *.local 이중 차단). 절대 커밋 금지.
#
# ── prod DB에 마이그레이션 올리는 방법은 2가지. 둘 중 하나만 하면 된다 ──
#
# [방법 A · 권장] supabase CLI link  ← 이 파일 자체가 필요 없음
#   호스트 주소를 몰라도 되고, DB 비밀번호만 있으면 된다.
#     supabase login                                      # 브라우저 인증(1회)
#     supabase link --project-ref yzbjvkifwinumytehxgf    # DB 비밀번호 1회 입력(프롬프트)
#     supabase db push                                    # prod에 마이그 적용
#   비밀번호는 프롬프트에만 입력 → 파일에 저장 안 됨. 가장 깔끔.
#
# [방법 B] 이 파일에 접속 URL 저장 → `npm run db:push:prod`
#   db:push:prod 가 --env-file-if-exists 로 이 파일을 자동 로드한다.
#   아래 두 줄을 실제 값으로 채운 뒤 `npm run db:push:prod`.
#
# ⚠️ DB 비밀번호는 대시보드에서 "생성 후 다시 볼 수 없음". 비밀번호 매니저에 따로 보관할 것.
#    (새 컴퓨터 이관·link 캐시 소실 시 이 비번이 있어야 재연결 가능. 없으면 Reset 재발급.)
# ───────────────────────────────────────────────────────────────────────────

# prod DB 접속 문자열(Session pooler 권장). 대시보드:
#   project yzbjvkifwinumytehxgf → 상단 Connect → Connection String → Session pooler 복사,
#   [YOUR-PASSWORD] 자리에 DB 비밀번호 입력 후 아래에 통째로 붙여넣기.
# 형식: postgresql://postgres.yzbjvkifwinumytehxgf:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL_PROD=

# prod 오발사 방지 확인 플래그. 매번 플래그 없이 바로 적용하려면 yes 유지.
CONFIRM_PROD=yes
