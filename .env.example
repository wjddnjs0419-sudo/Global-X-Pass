# .env.example — 로컬 개발용 템플릿
# 사용법: cp .env.example .env  후, 아래 🔴 표시 값만 안전채널로 받은 실값으로 교체.
# 🟢 값은 로컬 Docker(supabase start) 기본값이라 그대로 두면 바로 동작.
# 진짜 비밀값 출처: ONBOARDING.md §3-6 "반드시 전달할 secret 값".

# 🟢 로컬 Supabase (supabase start 기본 — 그대로 사용)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# 🟢 super admin UID(쉼표 구분). seed.sql의 로컬 admin UID. functions/.env의 SUPER_ADMIN_UIDS와 동일하게 유지.
# 게이트가 EF 없이 super 를 판정해 일반 admin 우회 로그인 루프를 막는다.
VITE_SUPER_ADMIN_UIDS=a0000000-0000-0000-0000-000000000001

# 🟢 로컬 service_role 키(Docker 기본값 — 로컬 전용, 그대로 사용)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# 🔴 암호화 키 — prod PII 복호화에 쓰이는 교체불가 비밀. 안전채널로 받은 값을 넣어라.
#    (로컬만 돌릴 거면 임의 64-hex도 됨: openssl rand -hex 32. 단 prod와 다르면 prod 데이터 복호 불가.)
ENCRYPTION_SECRET_KEY=

# 🔴 외부 API 키 — 안전채널로 받은 값. (로컬에선 뉴스/블로그 크롤 미동작, 비워도 dev 구동엔 무관)
GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
