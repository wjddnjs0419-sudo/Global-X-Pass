# supabase/functions/.env.example — 로컬 Edge Function 런타임용 템플릿
# 사용법: cp supabase/functions/.env.example supabase/functions/.env  후 🔴 값 교체.
# supabase start 시 로컬 EF가 이 값을 읽는다. 진짜 비밀 출처: ONBOARDING.md §3-6.

# 🔴 루트 .env의 ENCRYPTION_SECRET_KEY와 반드시 동일한 값.
ENCRYPTION_SECRET_KEY=

# 🟢 루트 .env의 VITE_SUPER_ADMIN_UIDS와 동일하게 유지(seed 로컬 admin UID).
SUPER_ADMIN_UIDS=a0000000-0000-0000-0000-000000000001
