{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "diet": "node scripts/compact-docs.mjs",
    "prebuild": "node scripts/check-build-target.mjs",
    "build": "vite build",
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "prebuild:staging": "node scripts/check-build-target.mjs",
    "build:staging": "vite build --mode staging",
    "preview:staging": "npm run build:staging && vite preview --mode staging --port 4173",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push:staging": "url=$(node scripts/check-deploy-target.mjs staging) && supabase db push --db-url \"$url\"",
    "db:push:prod": "url=$(node scripts/check-deploy-target.mjs prod) && supabase db push --db-url \"$url\"",
    "map:dev": "vite --config vite.architecture.config.ts --host 127.0.0.1",
    "map:build": "vite build --config vite.architecture.config.ts",
    "app:dev": "GXP_ARCHITECTURE_APP_DEV=1 electron electron/main.cjs",
    "app:pack": "npm run map:build && electron-builder --dir",
    "app:build": "npm run map:build && electron-builder",
    "blog:discover": "node scripts/import-blog-posts.mjs --discover",
    "blog:crawl": "node scripts/import-blog-posts.mjs --crawl",
    "blog:import": "node scripts/import-blog-posts.mjs --write",
    "blog:import:dry-run": "node scripts/import-blog-posts.mjs --dry-run",
    "blog:sync": "node scripts/import-blog-posts.mjs --write --mirror-images --update-existing",
    "blog:worker": "node scripts/import-blog-posts.mjs --process-queue --write --mirror-images",
    "blog:analyze-style": "node scripts/analyze-blog-style.mjs",
    "blog:ai-generate": "node scripts/generate-ai-post.mjs",
    "news:crawl": "node scripts/crawl-company-news.mjs",
    "news:crawl:dry-run": "node scripts/crawl-company-news.mjs --dry-run",
    "check:frontend-secrets": "node scripts/check-frontend-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsc --noEmit && eslint src/ --max-warnings=0 && vitest run && vite build && npm run check:frontend-secrets"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@supabase/supabase-js": "^2.104.0",
    "@types/dompurify": "^3.0.5",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "dompurify": "^3.4.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-quill": "^2.0.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "otplib": "^13.4.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "6.4.2",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "build": {
    "appId": "com.globalxpass.architecturemap",
    "productName": "Global X Pass Architecture Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-architecture/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src/imports/changgu-symbol.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  }
}
