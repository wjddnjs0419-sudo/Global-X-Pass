# .env.production.local.example — 프로덕션 빌드용 템플릿
# 사용법: cp .env.production.local.example .env.production.local  후 모든 🔴 값 교체.
# npm run build 가 이 파일을 로드해 prod 백엔드(yzbjvkifwinumytehxgf)를 가리키는 dist/ 생성.
# ⚠️ 실제 비밀값은 절대 git 커밋 금지. 안전채널로 받아라(ONBOARDING.md §3-6).

# 🟢 prod 백엔드 주소(고정)
VITE_SUPABASE_URL=https://yzbjvkifwinumytehxgf.supabase.co

# 🔴 prod anon(publishable) 키 — Supabase 대시보드 Project Settings → API
VITE_SUPABASE_ANON_KEY=

# 🔴 prod super admin UID(쉼표 구분). 서버 SUPER_ADMIN_UIDS와 동일해야 super만 우회 무효화.
VITE_SUPER_ADMIN_UIDS=

# 🔴 교체불가 암호화 키 — 로컬/EF/Supabase secrets와 전부 동일 값이어야 함
ENCRYPTION_SECRET_KEY=

# 🔴 prod service_role 키(JWT) — Supabase 대시보드 → API. 노출 시 즉시 재발급
SUPABASE_SERVICE_ROLE_KEY=

# 🔴 외부 API 키
GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
